# Optional: set this to the public production origin once it is known.
# Used only for absolute Open Graph metadata. Do not invent a domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery. When unset, the form runs in an honest demo state:
# it validates input but reports that nothing was delivered.
# Set this to a server-side webhook that accepts a JSON POST.
# INQUIRY_WEBHOOK_URL=https://example.com/api/inquiries

# Optional bearer token sent to the webhook.
# INQUIRY_WEBHOOK_TOKEN=
